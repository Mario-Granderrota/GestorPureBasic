XIncludeFile "../src/nucleo.pbi"
OpenConsole()
Global Correctas.i,Fallos.i
Procedure Comprobar(valor.i,texto.s)
  If valor : Correctas+1 : PrintN("OK "+texto) : Else : Fallos+1 : PrintN("FALLO "+texto+" | "+ErrorActual) : EndIf
EndProcedure
If Not Inicializar(ProgramParameter(0)) : PrintN(ErrorActual) : End 2 : EndIf
Define ruta.s=Hogar+"/unicode.txt", *bytes=AllocateMemory(8), resultado.ResultadoProcesoPB, dato.VersionPB, leido.VersionPB, id.s, json, valor, campo, movimiento.MovimientoPB, NewList rutas.s(), fd, archivo, origen.s=ProgramParameter(1)
Comprobar(Bool(Guardar(ruta,"áéñ漢字") And LeerTexto(ruta)="áéñ漢字"),"lectura y escritura Unicode exactas")
Comprobar(Bool(Guardar(ruta,"") And LeerTexto(ruta)="" And FileSize(ruta)=0),"texto vacio")
PokeA(*bytes,$C3) : PokeA(*bytes+1,$A9) : PokeA(*bytes+2,88)
Comprobar(Bool(TextoSeguro::UTF8Valido(*bytes,2) And CampoTar(*bytes,2)="é"),"campo TAR acotado por bytes")
Comprobar(Bool(Not TextoSeguro::UTF8Valido(*bytes,1) And TextoSeguro::TextoSalidaUTF8(*bytes,1)=""),"secuencia incompleta no se decodifica fuera del limite")
Comprobar(Bool(TextoSeguro::TextoSalidaUTF8(*bytes,3)="éX"),"decodificacion de salida por bytes")
PokeA(*bytes,$C0) : PokeA(*bytes+1,$AF)
Comprobar(Bool(Not TextoSeguro::UTF8Valido(*bytes,2) And CampoTar(*bytes,2)=Chr(1)),"rechaza codificacion UTF8 sobrelarga")
PokeA(*bytes,$ED) : PokeA(*bytes+1,$A0) : PokeA(*bytes+2,$80)
Comprobar(Bool(Not TextoSeguro::UTF8Valido(*bytes,3)),"rechaza sustituto UTF16 en UTF8")
PokeA(*bytes,$F4) : PokeA(*bytes+1,$90) : PokeA(*bytes+2,$80) : PokeA(*bytes+3,$80)
Comprobar(Bool(Not TextoSeguro::UTF8Valido(*bytes,4)),"rechaza punto Unicode fuera de rango")
PokeA(*bytes,65) : PokeA(*bytes+1,0) : PokeA(*bytes+2,66)
Comprobar(Bool(Not TextoSeguro::UTF8Valido(*bytes,3)),"rechaza NUL incrustado")
archivo=CreateFile(#PB_Any,ruta) : WriteData(archivo,*bytes,3) : CloseFile(archivo)
Comprobar(Bool(LeerTexto(ruta)=""),"lector de registros rechaza NUL incrustado")
FreeMemory(*bytes)
Comprobar(Bool(EjecutarProceso("/usr/bin/python3","-c "+Citar("import os,time; os.write(1,bytes([195])); time.sleep(.12); os.write(1,bytes([169,88])); os.write(2,b'ERROR'+bytes([10]))"),Hogar,@resultado,5) And FindString(resultado\Salida,"éX")=1 And FindString(resultado\Salida,"ERROR")>0),"salida de proceso reconstruye UTF8 dividido entre escrituras")
Comprobar(SincronizarDirectorio(Hogar),"fsync del directorio de trabajo")
Comprobar(Bool(Not SincronizarDirectorio(ruta)),"fsync de directorio rechaza archivo regular")
Comprobar(SincronizarArchivo(ruta),"fsync de archivo regular")
id=IdNuevo() : dato\Id=id : dato\Ruta=Hogar+"/PB" : dato\Estado="disponible" : dato\Comprobada=1 : dato\NivelC=2
Comprobar(Bool(GuardarVersion(@dato) And LeerVersion(id,@leido) And leido\NivelC=2),"registro tipado correcto")
json=CreateJSON(#PB_Any) : InsertJSONStructure(JSONValue(json),@dato,VersionPB)
valor=JSONValue(json) : campo=GetJSONMember(valor,"Comprobada") : SetJSONString(campo,"1")
Guardar(Estado+"/versiones/"+id+".json",ComposeJSON(json))
Comprobar(Bool(Not LeerVersion(id,@leido) And leido\NivelC=2),"tipo incorrecto rechazado sin modificar destino")
SetJSONInteger(campo,1) : SetJSONDouble(GetJSONMember(valor,"NivelC"),1.5)
Guardar(Estado+"/versiones/"+id+".json",ComposeJSON(json))
Comprobar(Bool(Not LeerVersion(id,@leido)),"rechaza nivel fraccionario")
SetJSONInteger(GetJSONMember(valor,"NivelC"),9) : Guardar(Estado+"/versiones/"+id+".json",ComposeJSON(json))
Comprobar(Bool(Not LeerVersion(id,@leido)),"rechaza nivel fuera de rango")
SetJSONInteger(GetJSONMember(valor,"NivelC"),2) : SetJSONString(GetJSONMember(valor,"Estado"),"inventado")
Guardar(Estado+"/versiones/"+id+".json",ComposeJSON(json))
Comprobar(Bool(Not LeerVersion(id,@leido)),"rechaza estado desconocido")
FreeJSON(json) : DeleteFile(Estado+"/versiones/"+id+".json")
Guardar(Estado+"/activa.txt","ANTERIOR") : AddElement(rutas()) : rutas()=Estado+"/activa.txt"
Comprobar(IniciarTransaccion(rutas()),"inicia diario persistente")
Guardar(Estado+"/activa.txt","NUEVA")
json=ParseJSON(#PB_Any,LeerTexto(Estado+"/transaccion/diario.json")) : valor=GetJSONElement(JSONValue(json),0)
SetJSONString(GetJSONMember(valor,"Existia"),"1") : Guardar(Estado+"/transaccion/diario.json",ComposeJSON(json))
Comprobar(Bool(Not RecuperarTransaccion() And LeerTexto(Estado+"/activa.txt")="NUEVA"),"diario de tipo incorrecto no puede borrar destino")
SetJSONInteger(GetJSONMember(valor,"Existia"),1) : Guardar(Estado+"/transaccion/diario.json",ComposeJSON(json)) : FreeJSON(json)
Comprobar(Bool(RecuperarTransaccion() And LeerTexto(Estado+"/activa.txt")="ANTERIOR"),"diario valido vuelve al estado anterior")
DeleteFile(Estado+"/activa.txt")
; Usar una instalacion real con un proyecto presente desde antes del registro.
ruta=Hogar+"/PureBasic con datos" : Comprobar(CopiarArbol(origen,ruta),"copia aislada de SDK real")
Guardar(ruta+"/proyecto-personal.pb","CONTENIDO PERSONAL")
Comprobar(RegistrarExistente(ruta),"registra instalacion externa con proyecto previo")
CargarVersiones() : FirstElement(Versiones()) : id=Versiones()\Id
fd=BloqueoVersion(id,1)
Comprobar(Bool(fd>=0 And Not RetirarRecuperable(id) And FileSize(ruta)=-2),"bloqueo de sesion impide retirar")
If fd>=0 : CerrarNativo(fd) : EndIf
Comprobar(Bool(RetirarRecuperable(id) And LeerVersion(id,@dato) And dato\Estado="retirada"),"retirada recuperable sin borrado")
Comprobar(Bool(FileSize(ruta)=-1 And LeerTexto(dato\Ruta+"/proyecto-personal.pb")="CONTENIDO PERSONAL"),"conserva proyecto existente antes del registro")
Comprobar(Bool(RestaurarVersionRetirada(id) And LeerTexto(ruta+"/proyecto-personal.pb")="CONTENIDO PERSONAL"),"restaura proyecto y ubicacion exactos")
Comprobar(Bool(RetirarRecuperable(id) And LeerVersion(id,@dato) And FileSize(dato\Ruta)=-2),"segunda retirada reversible")
Comprobar(Bool(DesinstalarVersion(id,1) And Not LeerVersion(id,@dato) And FileSize(ruta)=-1),"purga solo tras solicitud distinta y expresa")
PrintN("RESULTADO: "+Str(Correctas)+" correctas, "+Str(Fallos)+" fallidas")
End Bool(Fallos>0)
