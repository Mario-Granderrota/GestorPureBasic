XIncludeFile "../src/nucleo.pbi"
OpenConsole()
Global Correctas.i,Fallos.i
Procedure Comprobar(valor.i,texto.s)
  If valor : Correctas+1 : PrintN("OK "+texto) : Else : Fallos+1 : PrintN("FALLO "+texto+" | "+ErrorActual) : EndIf
EndProcedure
If Not Inicializar(ProgramParameter(0)) : PrintN(ErrorActual) : End 2 : EndIf
Define paquete.PaquetePB, antigua.VersionPB,nueva.VersionPB, original.VersionPB, id.s, segundo.s, ruta.s, resultadoPrueba, origen.s=ProgramParameter(1)
PonerIdentidad(@antigua,"PureBasic 6.02 LTS (Linux - x64)")
PonerIdentidad(@nueva,"PureBasic 6.41 (Linux - x64) Free")
Comprobar(Bool(CompararVersiones(@nueva,@antigua)=1),"6.41 superior a 6.02")
Comprobar(Bool(CompararVersiones(@antigua,@nueva)=-1),"6.02 anterior a 6.41")
Comprobar(Bool(CompararVersiones(@nueva,@nueva)=0),"misma version")
PonerIdentidad(@antigua,"PureBasic 6.41 Beta 2 (Linux - x64)")
Comprobar(Bool(CompararVersiones(@nueva,@antigua)=1),"estable superior a beta")
PonerIdentidad(@nueva,"PureBasic 6.41 Beta 10 (Linux - x64)")
Comprobar(Bool(CompararVersiones(@nueva,@antigua)=1),"beta 10 superior a beta 2")
Comprobar(Bool(FindString(DiagnosticarSalida("libc.so.6: version GLIBC_2.38 not found"),"GLIBC 2.38")>0),"diagnostico GLIBC conserva version requerida")
Comprobar(Bool(FindString(DiagnosticarSalida("undefined reference to __wrap_memcpy"),"orden incorrecto")>0),"clasifica el error de enlazado memcpy")
Comprobar(PrepararPaquete(origen,@paquete),"detecta paquete real")
Comprobar(Bool(paquete\Dato\Numero="6.41" And paquete\Dato\Edicion="gratuita"),"identidad estatica correcta")
ruta=paquete\Temporal
LimpiarPaquete(@paquete)
Comprobar(Bool(FileSize(ruta)=-1 And Activa()=""),"cancelar limpia temporal y no activa")
Comprobar(PrepararPaquete(origen,@paquete),"prepara primera instalacion")
resultadoPrueba=ConfirmarPaquete(@paquete,"",0)
If resultadoPrueba=Politica::#SustitucionBloqueada
  Comprobar(Bool(Activa()="" And LeerTexto(Estado+"/ultima.txt")=""),"no publica una primera instalacion limitada sin consentimiento")
  resultadoPrueba=ConfirmarPaquete(@paquete,"",0,1)
EndIf
Comprobar(Bool(resultadoPrueba>0),"primera instalacion publicada")
id=LeerTexto(Estado+"/ultima.txt")
Comprobar(LeerVersion(id,@original),"registro de primera instalacion")
PrintN("Limitacion inicial: "+original\Limitacion)
PrintN("Diagnostico: "+original\Diagnostico)
Comprobar(Activar(id,1,0),"establece una anterior para probar conservacion de predeterminada")
Comprobar(Bool(FindString(original\Ruta,"PureBasic-6.41-gratuita")>0),"carpeta con nombre de version")
Comprobar(PrepararPaquete(origen,@paquete),"prepara segunda instalacion")
resultadoPrueba=ConfirmarPaquete(@paquete,id,0,1)
Comprobar(Bool(resultadoPrueba>0),"instalacion paralela")
segundo=LeerTexto(Estado+"/ultima.txt")
Comprobar(LeerVersion(segundo,@nueva),"registro de segunda instalacion")
Comprobar(Bool(nueva\Ruta<>original\Ruta And FileSize(original\Ruta)=-2 And FileSize(nueva\Ruta)=-2),"dos carpetas diferenciadas")
Comprobar(Bool(RutaPerfil(@original)<>RutaPerfil(@nueva)),"perfiles separados")
Comprobar(Bool(Activa()=id),"conservar ambas no cambia predeterminada")
Comprobar(Bool(FileSize(Datos+"/applications/PureBasic-6.41-gratuita-"+id+".desktop")>0 And FileSize(Datos+"/applications/PureBasic-6.41-gratuita-"+segundo+".desktop")>0),"accesos independientes")
Guardar(original\Ruta+"/proyecto-personal.pb","datos")
Comprobar(PrepararPaquete(origen,@paquete),"prepara sustitucion con cambios")
Comprobar(Bool(ConfirmarPaquete(@paquete,id,1)=0 And FileSize(original\Ruta+"/proyecto-personal.pb")>0),"protege archivos modificados")
DeleteFile(original\Ruta+"/proyecto-personal.pb")
Comprobar(PrepararPaquete(origen,@paquete),"prepara sustitucion limpia")
resultadoPrueba=ConfirmarPaquete(@paquete,id,1)
If resultadoPrueba=3
  Comprobar(Bool(FileSize(original\Ruta)=-2),"limitacion bloquea sustitucion y conserva anterior")
  Comprobar(Bool(ConfirmarPaquete(@paquete,id,1,1)=3 And FileSize(original\Ruta)=-2),"ni la antigua autorizacion expresa permite borrar")
  Comprobar(Bool(ConfirmarPaquete(@paquete,id,0,1)=Politica::#InstaladaLimitada),"permite conservar nueva por separado")
  Comprobar(Bool(FileSize(original\Ruta)=-2 And VerificarContenido(@original)),"anterior intacta y manifiesto valido")
  Comprobar(Bool(Activa()=id),"la incidencia conserva la predeterminada")
  Comprobar(Bool(FileSize(Datos+"/applications/PureBasic-6.41-gratuita-"+id+".desktop")>0),"conserva acceso anterior")
Else
  Comprobar(Bool(resultadoPrueba=1 And FileSize(original\Ruta)=-1 And LeerVersion(id,@antigua) And antigua\Estado="retirada" And FileSize(antigua\Ruta)=-2),"sustitucion limpia y anterior recuperable")
  Comprobar(Bool(FileSize(Datos+"/applications/PureBasic-6.41-gratuita-"+id+".desktop")=-1),"retira acceso anterior")
EndIf
Comprobar(Bool(FileSize(nueva\Ruta)=-2),"conserva tercera instalacion no seleccionada")
PrintN("RESULTADO: "+Str(Correctas)+" correctas, "+Str(Fallos)+" fallidas")
End Bool(Fallos>0)
